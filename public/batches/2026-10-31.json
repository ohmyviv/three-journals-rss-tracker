    {
      "doi": "10.1126/science.adz5646",
      "journal": "Science",
      "title": "A Martian meteorite that formed ≳4.1 billion years ago samples Mars' early crust and mantle.",
      "source_url": "https://doi.org/10.1126/science.adz5646",
      "rss_reported_time": "2026-10-29T08:00:00+08:00",
      "first_seen_at": "2026-10-31T10:42:30+08:00",
      "appearance_window_start": "2026-10-30T10:57:18+08:00",
      "appearance_window_end": "2026-10-31T10:42:30+08:00",
      "authors_rss": [
        "Liu Y",
        "Saper LM",
        "Bell EA",
        "Ma C",
        "Li H",
        "Hu J",
        "Guan Y",
        "Melton H",
