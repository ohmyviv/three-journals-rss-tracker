      "title": "Innate sensor responses set a supra-unitary threshold for viral replication.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.10.004",
      "rss_reported_time": "2026-10-29T08:00:00+08:00",
      "first_seen_at": "2026-10-31T10:42:30+08:00",
