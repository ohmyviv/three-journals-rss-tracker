    {
      "doi": "10.1016/j.cell.2026.09.059",
      "journal": "Cell",
      "title": "In vivo genome-editing therapy for Duchenne muscular dystrophy: Preclinical studies and first-in-human trial.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.09.059",
      "rss_reported_time": "2026-10-26T08:00:00+08:00",
      "first_seen_at": "2026-10-28T10:34:34+08:00",
      "appearance_window_start": "2026-10-27T10:24:44+08:00",
      "appearance_window_end": "2026-10-28T10:34:34+08:00",
      "authors_rss": [
