    {
      "doi": "10.1016/j.cell.2026.09.015",
      "journal": "Cell",
      "title": "The pyrin inflammasome senses OCTN2-mediated uptake of extracellular ʟ-carnitine from muscle injury or ingestion.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.09.015",
      "rss_reported_time": "2026-10-19T08:00:00+08:00",
      "first_seen_at": "2026-10-21T10:00:22+08:00",
      "appearance_window_start": "2026-10-20T10:04:33+08:00",
