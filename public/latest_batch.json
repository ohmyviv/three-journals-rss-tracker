      "doi": "10.1016/j.cell.2026.10.002",
      "journal": "Cell",
      "title": "CRISPR mutagenesis of the MYC locus reveals a druggable ultraconserved RNA element.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.10.002",
      "rss_reported_time": "2026-11-04T08:00:00+08:00",
      "first_seen_at": "2026-11-10T12:47:25+08:00",
      "appearance_window_start": "2026-11-09T10:57:49+08:00",
      "appearance_window_end": "2026-11-10T12:47:25+08:00",
      "authors_rss": [
        "Shi P",
