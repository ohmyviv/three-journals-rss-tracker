      "journal": "Cell",
      "title": "Age-dependent structural evolution of a functional amyloid contributes to memory impairment in Drosophila.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.10.009",
      "rss_reported_time": "2026-10-30T08:00:00+08:00",
      "first_seen_at": "2026-11-01T10:33:25+08:00",
      "appearance_window_start": "2026-10-31T10:42:30+08:00",
