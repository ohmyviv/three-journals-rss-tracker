      "journal": "Cell",
      "title": "Proteomic atlas of T cell exhaustion defines proteostatic collapse.",
      "source_url": "https://doi.org/10.1016/j.cell.2026.09.051",
      "rss_reported_time": "2026-10-21T08:00:00+08:00",
